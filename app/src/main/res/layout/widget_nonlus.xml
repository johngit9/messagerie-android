<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/fond_widget">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widget_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="28sp" android:textStyle="bold" android:textColor="#3B5BDB" android:text="0" />
        <TextView android:id="@+id/widget_libelle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#15171C" android:text="non lus" android:maxLines="2" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w0" android:layout_width="wrap_content" android:layout_height="26dp"
            android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center"
            android:background="@drawable/fond_pastille_widget" android:textSize="13sp" android:textStyle="bold"
            android:visibility="gone" />
        <TextView android:id="@+id/w1" android:layout_width="wrap_content" android:layout_height="26dp"
            android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center"
            android:background="@drawable/fond_pastille_widget" android:textSize="13sp" android:textStyle="bold"
            android:visibility="gone" />
        <TextView android:id="@+id/w2" android:layout_width="wrap_content" android:layout_height="26dp"
            android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center"
            android:background="@drawable/fond_pastille_widget" android:textSize="13sp" android:textStyle="bold"
            android:visibility="gone" />
        <TextView android:id="@+id/w3" android:layout_width="wrap_content" android:layout_height="26dp"
            android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center"
            android:background="@drawable/fond_pastille_widget" android:textSize="13sp" android:textStyle="bold"
            android:visibility="gone" />
        <TextView android:id="@+id/w4" android:layout_width="wrap_content" android:layout_height="26dp"
            android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center"
            android:background="@drawable/fond_pastille_widget" android:textSize="13sp" android:textStyle="bold"
            android:visibility="gone" />
        <TextView android:id="@+id/w5" android:layout_width="wrap_content" android:layout_height="26dp"
            android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center"
            android:background="@drawable/fond_pastille_widget" android:textSize="13sp" android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
